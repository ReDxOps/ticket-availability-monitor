# ==============================================================================
# Configuration du moniteur de billetterie Dream Nation 2026
# ==============================================================================

# Identifiants See Tickets Resell (découverts lors de la reconnaissance technique)
SEETICKETS_SITE_ID=496
SEETICKETS_EVENT_ID=2768
SEETICKETS_CATEGORY_ID=7897
SEETICKETS_CATEGORY_NAME="DREAM NATION 2026 - PASS 1 JOUR VENDREDI"
SEETICKETS_CATEGORY_SLUG="dream-nation-2026-pass-1-jour-vendredi"
SEETICKETS_SITE_NAME="dreamnation2026"

# Intervalle de surveillance en secondes (par défaut : 10, minimum autorisé : 5)
POLL_INTERVAL_SECONDS=10

# Objectif d'achat pour priorisation (par défaut : 2 billets)
TARGET_TICKETS_COUNT=2

# Date limite d'arrêt automatique du moniteur (ISO 8601 avec fuseau horaire)
# Vendredi 30 octobre 2026 au matin (ou 31 octobre 05h00)
CUTOFF_DATE="2026-10-31T05:00:00+02:00"

# Telegram Bot - Notifications push sur iPhone
# Créer un bot via @BotFather pour obtenir le token
TELEGRAM_BOT_TOKEN="your_bot_token_here"
# Récupérer votre chat ID via @userinfobot ou l'API Telegram
TELEGRAM_CHAT_ID="your_chat_id_here"

# Auto-Cart (Optionnel) - Cookie de session See Tickets pour réservation automatique
# Récupérable dans votre navigateur (F12 > Application/Stockage > Cookies > resale)
SEETICKETS_SESSION_COOKIE=""

# Seuil d'erreurs consécutives avant envoi d'une alerte technique (par défaut : 10)
CONSECUTIVE_ERRORS_THRESHOLD=10

# Persistance des données
DB_PATH="data/monitor.db"

# Niveau de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
